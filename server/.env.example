SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_AVALIACAO_DESTINO=

# Proxies na frente do servidor (nginx do client + proxy/TLS externo). Usado no rate limit por IP.
TRUST_PROXY_HOPS=2