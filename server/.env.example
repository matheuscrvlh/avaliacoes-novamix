JWT_SECRET=

CORS_ORIGIN=https://avaliacoes.lojanovamix.com.br,http://localhost:5173

DATABASE_URL=

# Alerta por e-mail para avaliações com nota menor que 4 (todas são gravadas no banco).
# Se algum destes estiver vazio, o alerta por e-mail fica desativado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_AVALIACAO_DESTINO=

# Proxies na frente do servidor (nginx do client + proxy/TLS externo). Usado no rate limit por IP.
TRUST_PROXY_HOPS=2

# Envio direto dos relatórios pelo WhatsApp (API oficial da Meta, ver README).
# Sem TOKEN e PHONE_NUMBER_ID o painel só abre a conversa com a mensagem pronta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=relatorio_avaliacoes
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
WHATSAPP_API_VERSION=v23.0